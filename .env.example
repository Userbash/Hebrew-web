# Hebrew AI 2025 - Environment Configuration
# Copy this file to .env and configure with your values

# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=fullstack_db
DB_PORT=5432

# Backend Configuration
BACKEND_PORT=3001
NODE_ENV=production
LOG_LEVEL=info
API_TIMEOUT=30000

# Frontend Configuration
FRONTEND_PORT=3000
FRONTEND_API_HOST=localhost

# Nginx Configuration
NGINX_PORT=80
NGINX_HTTPS_PORT=443

# Redis Configuration
REDIS_PORT=6379

# Data Storage Path
DOCKER_DATA_PATH=./data
