# Hebrew AI 2025 - Environment Configuration
# Copy this file to .env and configure with your values

# Domain and SSL Configuration
# Get your deSEC.io token from https://desec.io/
DESEC_TOKEN=
# Your domain name. It will be created if it doesn't exist.
DOMAIN_NAME=
ADMIN_DOMAIN_NAME=
# Your email address for Let's Encrypt
ACME_EMAIL=
# Set to 1 to use Let's Encrypt staging environment for testing
LE_STAGING=0

# Container runtime integration (Docker/Podman)
# For Docker: /var/run/docker.sock
# For rootless Podman: /run/user/<uid>/podman/podman.sock
CONTAINER_SOCKET_PATH=/var/run/docker.sock
# Log path mounted for promtail discovery
CONTAINER_LOGS_PATH=/var/lib/docker/containers

# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=hebrew_ai_db
DB_PORT=5432

# Backend Configuration
BACKEND_PORT=3001
NODE_ENV=production
LOG_LEVEL=info
API_TIMEOUT=30000
JWT_SECRET=

# CORS
# Comma-separated list of allowed browser origins.
# Supports explicit origins and wildcard patterns, e.g. https://*.example.com
# Defaults to localhost/127.0.0.1 with standard ports (5173, 3000, 8081, 80) if empty.
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Email domain policy
# Hard blocklist (comma separated domains)
EMAIL_DOMAIN_BLOCKLIST=
# Optional allowlist with highest priority (comma separated domains)
EMAIL_DOMAIN_ALLOWLIST=
# Optional additional sources for auto-refresh (comma separated URLs)
EMAIL_DOMAIN_BLOCKLIST_SOURCES=
# 1 = enable automatic remote updates on backend startup + interval
EMAIL_DOMAIN_BLOCKLIST_AUTO_UPDATE=1
# Auto-refresh interval in minutes (minimum 15)
EMAIL_DOMAIN_BLOCKLIST_UPDATE_INTERVAL_MINUTES=360
# Optional override paths for cache/custom files
EMAIL_DOMAIN_BLOCKLIST_CACHE_FILE=
EMAIL_DOMAIN_BLOCKLIST_CUSTOM_FILE=

# Nginx Configuration
NGINX_PORT=80
NGINX_HTTPS_PORT=443

# Redis Configuration
REDIS_PORT=6379

# Data Storage Path
DOCKER_DATA_PATH=./data
