# Hebrew AI 2025 - Environment Configuration
# Copy this file to .env and configure with your values

# Domain and SSL Configuration
# Get your deSEC.io token from https://desec.io/
DESEC_TOKEN=
# Your domain name. It will be created if it doesn't exist.
DOMAIN_NAME=
# Your email address for Let's Encrypt
ACME_EMAIL=
# Set to 1 to use Let's Encrypt staging environment for testing
LE_STAGING=0

# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=fullstack_db
DB_PORT=5432

# Backend Configuration
BACKEND_PORT=3001
NODE_ENV=production
LOG_LEVEL=info
API_TIMEOUT=30000

# Nginx Configuration
NGINX_PORT=80
NGINX_HTTPS_PORT=443

# Redis Configuration
REDIS_PORT=6379

# Data Storage Path
DOCKER_DATA_PATH=./data
