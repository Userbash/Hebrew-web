{
  "page": "admin_logs",
  "surface": "admin_panel",
  "goal": "Inspect API telemetry, response codes, and operational noise.",
  "layout": "observability_table",
  "components": [
    "telemetry_summary_cards",
    "code_histogram",
    "path_failure_table",
    "log_filter_bar",
    "request_detail_drawer"
