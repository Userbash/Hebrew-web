# Backend runtime
NODE_ENV=development
BACKEND_PORT=3001

# PostgreSQL connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hebrew_ai_db
# Optional DSN
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/hebrew_ai_db

# DB bootstrap behavior
DB_AUTO_CREATE=true
DB_CONNECT_RETRY_ATTEMPTS=5
DB_CONNECT_RETRY_DELAY_MS=500

# Seed default user on first deploy/start (idempotent)
DB_DEFAULT_USER_ENABLED=true
DB_DEFAULT_USER_EMAIL=admin@local.test
DB_DEFAULT_USER_USERNAME=admin_local
DB_DEFAULT_USER_PASSWORD=ChangeMe123!
DB_DEFAULT_USER_FIRST_NAME=Local
DB_DEFAULT_USER_LAST_NAME=Admin
# platform_admin gives broad rights through RBAC mapping
DB_DEFAULT_USER_ROLE=platform_admin
DB_DEFAULT_USER_BLOCKED=false

# Redis connection
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_URL=redis://127.0.0.1:6379

# Startup behavior
BACKEND_ALLOW_DEGRADED_START=true

# CORS
# Comma-separated list of allowed browser origins.
# Defaults to localhost/127.0.0.1 with standard ports (5173, 3000, 8081, 80) if empty.
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://localhost:8081
